import java.util.*;

public class Main {

    public static void prefixSum(int n, int[] arr) {
        int[] prefix = new int[n];

        // First element
        prefix[0] = arr[0];

        // Compute prefix sum
        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + arr[i];
        }

        // Print result
        for (int i = 0; i < n; i++) {
            System.out.print(prefix[i] + " ");
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        prefixSum(n, arr);
    }
}
